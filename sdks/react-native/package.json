{
  "name": "@tugboat-ai/react-native",
  "version": "0.0.8",
  "description": "Tugboat session capture for React Native (Android and iOS).",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/blendto/tugboat-mobile-sdk/tree/main/sdks/react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendto/tugboat-mobile-sdk.git",
    "directory": "sdks/react-native"
  },
  "bugs": {
    "url": "https://github.com/blendto/tugboat-mobile-sdk/issues"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "TugboatReactNative.podspec",
    "LICENSE",
    "CHANGELOG.md",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx"
  ],
  "peerDependencies": {
    "@react-navigation/native": "*",
    "react": "*",
    "react-native": ">=0.88.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "TugboatSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.tugboat.reactnative"
    },
    "ios": {
      "modulesConformingToProtocol": {
        "RCTURLRequestHandler": [
          "TugboatHTTPRequestHandler"
        ]
      },
      "components": {
        "TugboatSensitiveView": {
          "className": "TugboatSensitiveViewComponentView"
        }
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
