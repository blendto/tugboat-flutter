{
  "name": "@tugboat/react-native",
  "version": "0.0.6",
  "private": true,
  "description": "Tugboat session capture for React Native (Android and iOS, unpublished).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "android",
    "ios",
    "TugboatReactNative.podspec"
  ],
  "peerDependencies": {
    "@react-navigation/native": "*",
    "react": "*",
    "react-native": ">=0.88.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "codegenConfig": {
    "name": "TugboatSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.tugboat.reactnative"
    },
    "ios": {
      "modulesConformingToProtocol": {
        "RCTURLRequestHandler": [
          "TugboatHTTPRequestHandler"
        ]
      },
      "components": {
        "TugboatSensitiveView": {
          "className": "TugboatSensitiveViewComponentView"
        }
      }
    }
  }
}
