platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# Monorepo checkout: the example always builds against the
# TugboatCaptureRuntime source in this repo, whatever its version. The
# plugin's tugboat.podspec pins the runtime release published on trunk; that
# pin is rewritten to the in-repo version for this resolve only, so the
# published podspec stays as it is.
repo_root = File.expand_path('../../../../../../', __dir__)
in_repo_runtime = Pod::Specification.from_file(File.join(repo_root, 'TugboatCaptureRuntime.podspec'))

module TugboatInRepoRuntime
  class << self
    attr_accessor :version
  end

  def dependencies(platform = nil)
    pinned = super
    return pinned unless root.name == 'tugboat'

    pinned.map do |dependency|
      next dependency unless dependency.name == 'TugboatCaptureRuntime'

      Pod::Dependency.new(dependency.name, TugboatInRepoRuntime.version)
    end
  end
end
TugboatInRepoRuntime.version = in_repo_runtime.version.to_s
Pod::Specification.prepend(TugboatInRepoRuntime)

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  pod 'TugboatCaptureRuntime', :path => repo_root
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
