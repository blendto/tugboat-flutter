<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View tag key for the developer alias (`tugboatTag`). Its entry name
         doubles as the resource-name obfuscation probe. -->
    <item name="tugboat_view_tag" type="id" />
    <!-- View tag key marking SDK-owned views, which identity and masks skip. -->
    <item name="tugboat_sdk_owned" type="id" />
    <!-- View tag key for `tugboatSensitive`: the view and its subtree are
         always masked. Masks read it; identity never does. -->
    <item name="tugboat_sensitive" type="id" />
</resources>
