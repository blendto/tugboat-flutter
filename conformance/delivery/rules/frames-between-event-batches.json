{
  "fixtureFormat": 1,
  "kind": "delivery.rules",
  "name": "frames-between-event-batches",
  "description": "A pass uploads frames between event batches, and drains only the events queued when it reached them. A frame captured while the first of two batches is in flight goes out before the second batch, not at the start of a pass; the interaction event that references it waits for the next pass.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 7
  },
  "input": {
    "collector": {
      "batchSize": 2
    },
    "steps": [
      {
        "note": "first event",
        "do": {
          "event": "e1"
        }
      },
      {
        "note": "a batch goes out",
        "do": {
          "event": "e2"
        }
      },
      {
        "note": "queued while it is in flight",
        "do": {
          "event": "e3"
        }
      },
      {
        "note": "queued",
        "do": {
          "event": "e4"
        }
      },
      {
        "note": "queued",
        "do": {
          "event": "e5"
        }
      },
      {
        "note": "queued: four events wait",
        "do": {
          "event": "e6"
        }
      },
      {
        "note": "the batch is delivered: the next pass takes the four events, two per batch",
        "do": {
          "answer": {
            "outcome": "http",
            "status": 202
          }
        }
      },
      {
        "note": "a frame arrives during the first batch, with the interaction event that references it",
        "do": {
          "frame": {
            "bytes": 48000
          }
        }
      },
      {
        "note": "the first batch is delivered: the frame goes before the second batch",
        "do": {
          "answer": {
            "outcome": "http",
            "status": 202
          }
        }
      },
      {
        "note": "the frame is delivered: the second batch follows",
        "do": {
          "answer": {
            "outcome": "http",
            "status": 202
          }
        }
      },
      {
        "note": "the pass is done: the interaction event is next",
        "do": {
          "answer": {
            "outcome": "http",
            "status": 202
          }
        }
      },
      {
        "note": "delivered",
        "do": {
          "answer": {
            "outcome": "http",
            "status": 202
          }
        }
      }
    ]
  },
  "expected": {
