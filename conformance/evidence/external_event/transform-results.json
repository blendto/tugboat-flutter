  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "input": {
    "name": "profile",
    "policy": {
      "mode": "transform"
    },
    "parameters": {
      "map": [
        [
          "email",
          {
            "drop": true
          }
        ],
        [
          "plan",
          "pro"
        ],
        [
          "cleared",
          null
        ],
        [
          "",
          null
        ],
        [
          "nested",
          {
            "map": [
              [
                "x",
                {
                  "double": 2.5
                }
              ]
            ]
          }
        ],
        [
          "bad",
          {
            "double": "NaN"
          }
        ]
      ]
    }
  },
  "expected": {
    "data": {
      "name": "profile",
      "parameterKeys": [
        "email",
        "plan",
        "cleared",
        "nested",
        "bad"
      ],
      "parameters": {
        "plan": "pro",
        "cleared": null,
        "nested": {
          "x": 2.5
        }
      },
      "capture": {
        "values": "transform",
        "truncated": true,
        "droppedCount": 3
      }
    }
  }
}
