{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "delivery-handshake-session-id",
  "description": "session_start posts with the local session id; the accepted response's sessionId becomes the collector session id, which events are stamped with when sent. Until then events and frames wait.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "input": {
    "configure": {
      "host": {
        "app": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app"
        },
        "device": {
          "id": "device-0001",
          "platform": "android",
          "manufacturer": "Google",
          "model": "Pixel 8",
          "osVersion": "15",
          "networkType": "wifi",
          "screenSize": {
            "width": 412.0,
            "height": 915.0
          },
          "screenDensity": 2.625,
          "screenDpi": 420,
          "screenPixelDensity": 2.625
        },
        "ip": {
          "ip": "203.0.113.7"
        },
        "locale": {
          "language": "en",
          "country": "US",
          "timezone": "Europe/Lisbon"
        },
        "configuredUserId": "user-configured"
      },
      "collector": {
        "enabled": true
      }
    },
    "steps": [
      {
        "note": "session_start goes out at once with the local id",
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-0",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 8000000
            },
            {
              "type": "http.send",
              "requestId": "http-0",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827200000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-0",
              "atMonoUs": 25000000
            },
            {
              "type": "capture.request",
              "requestId": "capture-0",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 5000000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            }
          ]
        }
      },
      {
        "note": "no collector session id yet: the event waits",
        "send": {
          "type": "event.record",
          "at": {
            "monoUs": 5100000,
            "wallUs": 1781827200100000
          },
          "input": {
            "eventType": "external_event",
            "stream": "evidence",
            "attachActionContext": false,
            "data": {
              "name": "before-handshake"
            }
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-2",
                "atMs": 100,
                "type": "external_event",
                "stream": "evidence",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "name": "before-handshake"
                }
              },
              "userId": "user-configured"
            }
          ],
          "effects": []
        }
      },
      {
        "note": "a pass while session_start is in flight only marks a follow-up (C2); Dart drops it, and both send nothing",
        "send": {
          "type": "transport.flush",
          "at": {
            "monoUs": 5200000,
            "wallUs": 1781827200200000
          },
          "input": {}
        },
        "expect": {
          "records": [],
          "effects": []
        }
      },
      {
        "note": "accepted: the pass continues to the events lane with the collector id",
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5300000,
            "wallUs": 1781827200300000
          },
          "input": {
            "requestId": "http-0",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-1\"}"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-0"
            },
            {
              "type": "http.send",
              "requestId": "http-1",
              "lane": "events",
              "path": "/v1/events/batch",
              "timeoutMs": 15000,
              "jsonBody": "{\"events\":[{\"id\":\"event-2\",\"atMs\":100,\"triggeredAt\":\"2026-06-19T00:00:00.100Z\",\"userId\":\"user-configured\",\"eventType\":\"external_event\",\"stream\":\"evidence\",\"enrichmentCandidate\":false,\"payload\":{\"name\":\"before-handshake\"},\"build\":{\"appId\":\"com.example.app\",\"platform\":\"android\",\"versionName\":\"2.4.0\",\"buildNumber\":\"240\",\"fingerprintSchemaVersion\":6},\"sessionId\":\"srv-1\"}]}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-1",
              "atMonoUs": 25300000
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5350000,
            "wallUs": 1781827200350000
          },
          "input": {
            "requestId": "http-1",
            "outcome": "http",
            "status": 202
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-1"
            }
          ]
        }
      },
      {
        "send": {
          "type": "event.record",
          "at": {
            "monoUs": 5400000,
            "wallUs": 1781827200400000
          },
          "input": {
            "eventType": "external_event",
            "stream": "evidence",
            "attachActionContext": false,
            "data": {
              "name": "after-handshake"
            }
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-3",
                "atMs": 400,
                "type": "external_event",
                "stream": "evidence",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "name": "after-handshake"
                }
              },
              "userId": "user-configured"
            }
          ],
          "effects": []
        }
      },
      {
        "send": {
          "type": "transport.flush",
          "at": {
            "monoUs": 5500000,
            "wallUs": 1781827200500000
          },
          "input": {}
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "http.send",
              "requestId": "http-2",
              "lane": "events",
              "path": "/v1/events/batch",
              "timeoutMs": 15000,
              "jsonBody": "{\"events\":[{\"id\":\"event-3\",\"atMs\":400,\"triggeredAt\":\"2026-06-19T00:00:00.400Z\",\"userId\":\"user-configured\",\"eventType\":\"external_event\",\"stream\":\"evidence\",\"enrichmentCandidate\":false,\"payload\":{\"name\":\"after-handshake\"},\"build\":{\"appId\":\"com.example.app\",\"platform\":\"android\",\"versionName\":\"2.4.0\",\"buildNumber\":\"240\",\"fingerprintSchemaVersion\":6},\"sessionId\":\"srv-1\"}]}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-2",
              "atMonoUs": 25500000
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5600000,
            "wallUs": 1781827200600000
          },
          "input": {
            "requestId": "http-2",
            "outcome": "http",
            "status": 202
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-2"
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": {
      "schemaVersion": 10,
      "session": {
        "id": "session-1781827200000000",
        "captureSessionId": "session-1781827200000000",
        "startedAt": "2026-06-19T00:00:00.000Z",
        "platform": "android",
        "viewport": {
          "x": 0.0,
          "y": 0.0,
          "width": 412.0,
          "height": 915.0
        },
        "truncated": false,
        "appInfo": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app",
          "packageName": "com.example.app"
        }
      },
      "frames": [],
      "events": [
        {
          "id": "event-0",
          "atMs": 0,
          "type": "session_start",
          "stream": "semantic",
          "captureSessionId": "session-1781827200000000"
        },
        {
          "id": "event-2",
          "atMs": 100,
          "type": "external_event",
          "stream": "evidence",
          "captureSessionId": "session-1781827200000000",
          "data": {
            "name": "before-handshake"
          }
        },
        {
          "id": "event-3",
          "atMs": 400,
          "type": "external_event",
          "stream": "evidence",
          "captureSessionId": "session-1781827200000000",
          "data": {
            "name": "after-handshake"
          }
        }
      ]
    }
  }
}
