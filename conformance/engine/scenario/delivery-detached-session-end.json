{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "delivery-detached-session-end",
  "description": "app.lifecycle detached ends the session with only a monotonic time stamp. The collector session_end then has no wall time of its own, so its triggeredAt is the session start wall time plus atMs (2.5 s after start), as for events, never the epoch.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 7
  },
  "runners": [
    "cpp"
  ],
  "input": {
    "configure": {
      "host": {"$preset": "default-host", "configuredUserId": "user-configured"},
      "collector": {
        "enabled": true
      }
    },
    "steps": [
      {
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0,
            "idSeed": "092ed43f85d7b33442dd0b3d31c8fbe05901113a5b6b45dfe32190cd6e258b3a"
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-cd23b16a-9ea3-489b-8326-bcd5e5454ebd",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-2d7a221c-a34c-496a-923a-3409592a8a51"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 8000000
            },
            {
              "type": "http.send",
              "requestId": "http-0",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-2d7a221c-a34c-496a-923a-3409592a8a51\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"installationId\":\"inst-0001\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}",
              "sessionId": "session-2d7a221c-a34c-496a-923a-3409592a8a51",
              "deliveryKeys": [
                "session-2d7a221c-a34c-496a-923a-3409592a8a51/l/session_start/2026-06-19T00:00:00.000Z"
              ],
              "isSessionEnd": false
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-0",
              "atMonoUs": 25000000
            },
            {
              "type": "capture.request",
              "requestId": "capture-0",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 5000000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            },
            {
              "type": "timer.schedule",
              "timerId": "capture.answer.capture-0",
              "atMonoUs": 10000000
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5010000,
            "wallUs": 1781827200010000
          },
          "input": {
            "requestId": "http-0",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-1\"}"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-0"
            }
          ]
        }
      },
      {
        "note": "app.lifecycle carries only a monotonic time stamp",
        "send": {
          "type": "app.lifecycle",
          "at": {
            "monoUs": 7500000
          },
          "input": {
            "state": "detached"
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-ef1ce71d-541d-44bc-89ea-5f6ec5fc0521",
                "atMs": 2500,
                "type": "app_detached",
                "stream": "semantic",
                "captureSessionId": "session-2d7a221c-a34c-496a-923a-3409592a8a51",
                "data": {
                  "state": "detached"
                }
              },
              "userId": "user-configured"
            },
            {
              "kind": "event",
              "event": {
                "id": "event-aff28b86-b36d-496c-8800-cd4d829d18c0",
                "atMs": 2500,
                "type": "session_end",
                "stream": "semantic",
                "captureSessionId": "session-2d7a221c-a34c-496a-923a-3409592a8a51"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "capture.answer.capture-0"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.endDrain",
              "atMonoUs": 12500000
            },
            {
              "type": "http.send",
              "requestId": "http-1",
              "lane": "events",
              "path": "/v1/events/batch",
              "timeoutMs": 15000,
              "jsonBody": "{\"events\":[{\"id\":\"event-ef1ce71d-541d-44bc-89ea-5f6ec5fc0521\",\"atMs\":2500,\"triggeredAt\":\"2026-06-19T00:00:02.500Z\",\"userId\":\"user-configured\",\"eventType\":\"app_detached\",\"stream\":\"semantic\",\"enrichmentCandidate\":false,\"payload\":{\"state\":\"detached\"},\"build\":{\"appId\":\"com.example.app\",\"platform\":\"android\",\"versionName\":\"2.4.0\",\"buildNumber\":\"240\",\"fingerprintSchemaVersion\":7},\"sessionId\":\"srv-1\"}]}",
              "sessionId": "srv-1",
              "deliveryKeys": [
                "srv-1/e/8cbf716cd46927ca"
              ],
              "isSessionEnd": false
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-1",
              "atMonoUs": 27500000
            }
          ]
        }
      },
      {
        "note": "the drain is over: session_end is posted with triggeredAt = start + atMs",
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 7600000,
            "wallUs": 1781827202600000
          },
          "input": {
            "requestId": "http-1",
            "outcome": "http",
            "status": 202
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-1"
            },
            {
              "type": "timer.cancel",
              "timerId": "delivery.endDrain"
            },
            {
              "type": "http.send",
              "requestId": "http-2",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"srv-1\",\"eventType\":\"session_end\",\"atMs\":2500,\"triggeredAt\":\"2026-06-19T00:00:02.500Z\",\"userId\":\"user-configured\"}",
              "sessionId": "srv-1",
              "deliveryKeys": [
                "srv-1/l/session_end/2026-06-19T00:00:02.500Z"
              ],
              "isSessionEnd": true
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-2",
              "atMonoUs": 27600000
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 7700000,
            "wallUs": 1781827202700000
          },
          "input": {
            "requestId": "http-2",
            "outcome": "http",
            "status": 202
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-2"
            },
            {
              "type": "timer.cancel",
              "timerId": "delivery.flush"
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": {
