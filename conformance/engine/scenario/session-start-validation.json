        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.sessionEpoch"
          }
        }
      },
      {
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 1,
              "height": 1
            },
            "platform": "android",
            "sessionEpoch": 0,
            "locale": {
              "language": "en"
