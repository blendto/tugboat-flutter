{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "session-start-validation",
  "description": "session.start needs a viewport with finite, non-negative width and height, a platform, and a non-negative integer sessionEpoch; a locale needs language and tag; unknown keys are rejected.",
