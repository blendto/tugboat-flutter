{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "unsupported-message-type",
  "description": "An unknown message type is unsupported_message at $.type; a batch element of unknown type is unsupported_message at its own path.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 7
  },
  "input": {
    "configure": {
      "host": {"$preset": "default-host"}
    },
    "steps": [
      {
        "send": {
          "type": "example.unknown",
          "at": {
            "monoUs": 5000000
          },
          "input": {}
        },
        "expect": {
          "error": {
            "status": "unsupported_message",
            "path": "$.type"
          }
        }
      },
      {
        "send": {
          "type": "batch",
          "messages": [
            {
              "type": "example.later",
              "at": {
                "monoUs": 5000000
              },
              "input": {}
            }
          ]
        },
        "expect": {
          "error": {
            "status": "unsupported_message",
            "path": "$.messages[0].type"
          }
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": null
  }
}
