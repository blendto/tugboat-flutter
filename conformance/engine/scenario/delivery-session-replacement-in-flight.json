{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "delivery-session-replacement-in-flight",
  "description": "A session.start that replaces a live session (C10) ends it first, which posts its session_end; the reset then reports that request as inFlight, not undelivered, and the new session_start waits for its answer, which is ignored (change C6: the report is a record).",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "engineOnly": [
    "C6",
    "C10"
  ],
  "input": {
    "configure": {
      "host": {
        "app": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app"
        },
        "device": {
          "id": "device-0001",
          "platform": "android",
          "manufacturer": "Google",
          "model": "Pixel 8",
          "osVersion": "15",
          "networkType": "wifi",
          "screenSize": {
            "width": 412.0,
            "height": 915.0
          },
          "screenDensity": 2.625,
          "screenDpi": 420,
          "screenPixelDensity": 2.625
        },
        "ip": {
          "ip": "203.0.113.7"
        },
        "locale": {
          "language": "en",
          "country": "US",
          "timezone": "Europe/Lisbon"
        },
        "configuredUserId": "user-configured"
      },
      "collector": {
        "enabled": true
      }
    },
    "steps": [
      {
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-0",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 8000000
            },
            {
              "type": "http.send",
              "requestId": "http-0",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827200000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-0",
              "atMonoUs": 25000000
            },
            {
              "type": "capture.request",
              "requestId": "capture-0",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 5000000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5010000,
            "wallUs": 1781827200010000
          },
          "input": {
            "requestId": "http-0",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-1\"}"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-0"
            }
          ]
        }
      },
      {
        "note": "the old session ends (session_end goes out at once), then delivery resets",
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 6000000,
            "wallUs": 1781827201000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-3",
                "atMs": 1000,
                "type": "session_end",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": "user-configured"
            },
            {
              "kind": "event",
              "event": {
                "id": "event-4",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827201000000"
              },
              "userId": "user-configured"
            },
            {
              "kind": "health",
              "component": "collector_delivery",
              "counters": {
                "undeliveredLifecycle": 0,
                "undeliveredEvents": 0,
                "undeliveredFrames": 0,
                "inFlightLifecycle": 1,
                "inFlightEvents": 0,
                "inFlightFrames": 0
              }
            }
          ],
          "effects": [
            {
              "type": "http.send",
              "requestId": "http-1",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"srv-1\",\"eventType\":\"session_end\",\"atMs\":1000,\"triggeredAt\":\"2026-06-19T00:00:01.000Z\",\"userId\":\"user-configured\"}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-1",
              "atMonoUs": 26000000
            },
            {
              "type": "timer.cancel",
              "timerId": "delivery.flush"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 9000000
            },
            {
              "type": "capture.request",
              "requestId": "capture-1",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 6000000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            }
          ]
        }
      },
      {
        "note": "the orphaned session_end resolves; the new session_start follows",
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 6010000,
            "wallUs": 1781827201010000
          },
          "input": {
            "requestId": "http-1",
            "outcome": "http",
            "status": 202
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-1"
            },
            {
              "type": "http.send",
              "requestId": "http-2",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827201000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:01.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-2",
              "atMonoUs": 26010000
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 6020000,
            "wallUs": 1781827201020000
          },
          "input": {
            "requestId": "http-2",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-2\"}"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-2"
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": {
      "schemaVersion": 10,
      "session": {
        "id": "session-1781827201000000",
        "captureSessionId": "session-1781827201000000",
        "startedAt": "2026-06-19T00:00:01.000Z",
        "platform": "android",
        "viewport": {
          "x": 0.0,
          "y": 0.0,
          "width": 412.0,
          "height": 915.0
        },
        "truncated": false,
        "appInfo": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app",
          "packageName": "com.example.app"
        }
      },
      "frames": [],
      "events": [
        {
          "id": "event-4",
          "atMs": 0,
          "type": "session_start",
          "stream": "semantic",
          "captureSessionId": "session-1781827201000000"
        }
      ]
    }
  }
