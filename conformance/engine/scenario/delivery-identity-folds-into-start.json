{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "delivery-identity-folds-into-start",
  "description": "While session_start is still queued, identity changes are not posted: lifecycle bodies are built when sent, so the retried session_start carries the new user id and traits.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "input": {
    "configure": {
      "host": {
        "app": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app"
        },
        "device": {
          "id": "device-0001",
          "platform": "android",
          "manufacturer": "Google",
          "model": "Pixel 8",
          "osVersion": "15",
          "networkType": "wifi",
          "screenSize": {
            "width": 412.0,
            "height": 915.0
          },
          "screenDensity": 2.625,
          "screenDpi": 420,
          "screenPixelDensity": 2.625
        },
        "ip": {
          "ip": "203.0.113.7"
        },
        "locale": {
          "language": "en",
          "country": "US",
          "timezone": "Europe/Lisbon"
        },
        "configuredUserId": "user-configured"
      },
      "collector": {
        "enabled": true
      }
    },
    "steps": [
      {
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-0",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 8000000
            },
            {
              "type": "http.send",
              "requestId": "http-0",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827200000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-0",
              "atMonoUs": 25000000
            },
            {
              "type": "capture.request",
              "requestId": "capture-0",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 5000000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            },
            {
              "type": "timer.schedule",
              "timerId": "capture.answer.capture-0",
              "atMonoUs": 10000000
            }
          ]
        }
      },
      {
        "note": "session_start must be retried; it stays at the lifecycle head",
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5010000,
            "wallUs": 1781827200010000
          },
          "input": {
            "requestId": "http-0",
            "outcome": "http",
            "status": 503
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-0"
            }
          ]
        }
      },
      {
        "note": "folded into the pending session_start: no debounce timer",
        "send": {
          "type": "identity.set",
          "at": {
            "monoUs": 5100000,
            "wallUs": 1781827200100000
          },
          "input": {
            "userId": "user-2"
          }
        },
        "expect": {
          "records": [],
          "effects": []
        }
      },
      {
        "send": {
          "type": "traits.set",
          "at": {
            "monoUs": 5200000,
            "wallUs": 1781827200200000
          },
          "input": {
            "traits": {
              "plan": "pro"
            }
          }
        },
        "expect": {
          "records": [],
          "effects": []
        }
      },
      {
        "note": "the retried session_start carries userId user-2 and the traits bag",
        "send": {
          "type": "transport.flush",
          "at": {
            "monoUs": 5300000,
            "wallUs": 1781827200300000
          },
          "input": {}
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "http.send",
              "requestId": "http-1",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827200000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-2\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"},\"traits\":{\"plan\":\"pro\"}}"
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-1",
              "atMonoUs": 25300000
            }
          ]
        }
      },
      {
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 5310000,
            "wallUs": 1781827200310000
          },
          "input": {
            "requestId": "http-1",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-1\"}"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-1"
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": {
      "schemaVersion": 10,
      "session": {
        "id": "session-1781827200000000",
        "captureSessionId": "session-1781827200000000",
        "startedAt": "2026-06-19T00:00:00.000Z",
        "platform": "android",
        "viewport": {
          "x": 0.0,
          "y": 0.0,
          "width": 412.0,
          "height": 915.0
        },
        "truncated": false,
        "appInfo": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app",
          "packageName": "com.example.app"
        }
      },
      "frames": [],
      "events": [
        {
          "id": "event-0",
          "atMs": 0,
          "type": "session_start",
          "stream": "semantic",
          "captureSessionId": "session-1781827200000000"
        }
      ]
    }
  }
}
