{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "clock-time-stamp-bounds",
  "description": "Monotonic time stamps (at.monoUs, atMonoUs, startMonoUs, endMonoUs) are in [0, 2^62] and captureMicros is in [0, one day], so no deadline (a time stamp plus at most a few days) or screenshot budget cost can overflow int64. Larger values are rejected as invalid_message and change nothing; 2^62 itself is accepted.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "runners": [
    "cpp"
  ],
  "input": {
    "configure": {
      "host": {"$preset": "default-host", "configuredUserId": "user-configured"}
    },
    "steps": [
      {
        "note": "above 2^62",
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 4611686018427387905,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.at.monoUs"
          }
        }
      },
      {
        "note": "int64 max: a deadline after it would overflow",
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 9223372036854775807,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.at.monoUs"
          }
        }
      },
      {
        "note": "2^62 is the largest time stamp; every deadline after it still fits",
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 4611686018427387904,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-0",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "capture.request",
              "requestId": "capture-0",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 4611686018427387904,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            },
            {
              "type": "timer.schedule",
              "timerId": "capture.answer.capture-0",
              "atMonoUs": 4611686018432387904
            }
          ]
        }
      },
      {
        "send": {
          "type": "event.record",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "eventType": "external_event",
            "stream": "evidence",
            "attachActionContext": false,
            "atMonoUs": 4611686018427387905
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.atMonoUs"
          }
        }
      },
      {
        "send": {
          "type": "evidence.networkCall",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "method": "GET",
            "route": "/v1/items",
            "startMonoUs": 4611686018427387905,
            "endMonoUs": null,
            "statusCode": 200,
            "outcome": "response"
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.startMonoUs"
          }
        }
      },
      {
        "send": {
          "type": "evidence.networkCall",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "method": "GET",
            "route": "/v1/items",
            "startMonoUs": 0,
            "endMonoUs": 9223372036854775807,
            "statusCode": 200,
            "outcome": "response"
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.endMonoUs"
          }
        }
      },
      {
        "send": {
          "type": "evidence.externalEvent",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "name": "probe",
            "policy": {
              "mode": "allow_all"
            },
            "atMonoUs": 4611686018427387905
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.atMonoUs"
          }
        }
      },
      {
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 4611686018427387905
          },
          "input": {
            "timerId": "capture.answer.capture-0"
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.at.monoUs"
          }
        }
      },
      {
        "note": "captureMicros is a duration of at most a day; the screenshot budget adds it to the queue wait",
        "send": {
          "type": "capture.result",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "requestId": "capture-0",
            "outcome": "captured",
            "frame": {
              "handle": "h-0",
              "width": 1080,
              "height": 2400,
              "contentHash": "hash-0",
              "masked": true,
              "byteLength": 48000,
              "captureMicros": 9223372036854775807
            }
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.frame.captureMicros"
          }
        }
      },
      {
        "send": {
          "type": "capture.result",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "requestId": "capture-0",
            "outcome": "captured",
            "frame": {
              "handle": "h-0",
              "width": 1080,
              "height": 2400,
              "contentHash": "hash-0",
              "masked": true,
              "byteLength": 48000,
              "captureMicros": 86400000001
            }
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.input.frame.captureMicros"
          }
        }
      },
      {
        "note": "the largest capture time is accepted",
        "send": {
          "type": "capture.result",
          "at": {
            "monoUs": 4611686018427387904
          },
          "input": {
            "requestId": "capture-0",
            "outcome": "captured",
            "frame": {
              "handle": "h-0",
              "width": 1080,
              "height": 2400,
              "contentHash": "hash-0",
              "masked": true,
              "byteLength": 48000,
              "captureMicros": 86400000000
            }
          }
        },
        "expect": {
          "records": [
            {
              "kind": "frame",
              "handle": "h-0",
              "frame": {
                "id": "frame-2",
                "atMs": 0,
                "width": 1080,
                "height": 2400,
                "contentHash": "hash-0",
                "masked": true,
                "trigger": "initial",
                "byteLength": 48000,
                "captureMicros": 86400000000,
                "captureSessionId": "session-1781827200000000"
              }
            }
          ],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "capture.answer.capture-0"
            }
          ]
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": {
      "schemaVersion": 10,
      "session": {
        "id": "session-1781827200000000",
        "captureSessionId": "session-1781827200000000",
        "startedAt": "2026-06-19T00:00:00.000Z",
        "platform": "android",
        "viewport": {
          "x": 0.0,
          "y": 0.0,
