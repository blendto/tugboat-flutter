        }
      },
      "frames": [
        {
          "id": "frame-2",
          "atMs": 0,
          "width": 1080,
          "height": 2400,
          "contentHash": "hash-0",
          "masked": true,
          "trigger": "initial",
          "byteLength": 48000,
          "captureMicros": 86400000000,
          "captureSessionId": "session-1781827200000000"
        }
      ],
      "events": [
        {
          "id": "event-0",
          "atMs": 0,
          "type": "session_start",
          "stream": "semantic",
          "captureSessionId": "session-1781827200000000"
        }
      ]
    }
  }
}
