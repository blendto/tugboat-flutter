{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "batch-admission-after-end",
  "description": "Admission runs over the whole batch before anything applies: an event.record after a session.end in the same batch rejects the batch, so the session stays live and no session_end is recorded.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "engineOnly": [
    "C9"
  ],
  "input": {
    "configure": {
      "host": {
        "app": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app"
        },
        "device": {
          "id": "device-0001",
          "platform": "android",
          "manufacturer": "Google",
          "model": "Pixel 8",
          "osVersion": "15",
          "networkType": "wifi",
          "screenSize": {
            "width": 412.0,
            "height": 915.0
          },
          "screenDensity": 2.625,
          "screenDpi": 420,
          "screenPixelDensity": 2.625
        },
        "ip": {
          "ip": "203.0.113.7"
        },
        "locale": {
          "language": "en",
          "country": "US",
          "timezone": "Europe/Lisbon"
        },
        "configuredUserId": null
      }
    },
    "steps": [
      {
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-0",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": null
            }
          ],
          "effects": []
        }
      },
      {
        "send": {
          "type": "batch",
          "messages": [
            {
              "type": "session.end",
              "at": {
                "monoUs": 5100000,
                "wallUs": 1781827200100000
              },
              "input": {}
            },
            {
              "type": "event.record",
              "at": {
                "monoUs": 5110000
              },
              "input": {
                "eventType": "external_event",
                "stream": "evidence",
                "data": {
                  "name": "late"
                },
                "attachActionContext": false
              }
            }
          ]
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.messages[1].type"
          }
        }
      },
      {
        "send": {
          "type": "event.record",
          "at": {
            "monoUs": 5200000
          },
          "input": {
            "eventType": "external_event",
            "stream": "evidence",
            "data": {
              "name": "still-live"
            },
            "attachActionContext": false
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-1",
                "atMs": 200,
                "type": "external_event",
                "stream": "evidence",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "name": "still-live"
                }
              },
              "userId": null
            }
          ],
          "effects": []
        }
      }
    ]
  },
  "expected": {
    "finalSnapshot": {
      "schemaVersion": 10,
      "session": {
        "id": "session-1781827200000000",
        "captureSessionId": "session-1781827200000000",
        "startedAt": "2026-06-19T00:00:00.000Z",
        "platform": "android",
        "viewport": {
          "x": 0.0,
          "y": 0.0,
          "width": 412.0,
          "height": 915.0
        },
        "truncated": false,
        "appInfo": {
          "name": "Example App",
          "version": "2.4.0",
          "buildNumber": "240",
          "installationId": "inst-0001",
          "appId": "com.example.app",
          "packageName": "com.example.app"
        }
      },
      "frames": [],
      "events": [
        {
          "id": "event-0",
          "atMs": 0,
          "type": "session_start",
          "stream": "semantic",
          "captureSessionId": "session-1781827200000000"
        },
        {
          "id": "event-1",
          "atMs": 200,
          "type": "external_event",
          "stream": "evidence",
          "captureSessionId": "session-1781827200000000",
          "data": {
            "name": "still-live"
          }
        }
      ]
    }
  }
}
