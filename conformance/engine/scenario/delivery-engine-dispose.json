            "x": 100.0,
            "y": 100.0,
            "device": "touch"
          }
        },
        "expect": {
          "records": [],
          "effects": []
        }
      },
      {
        "send": {
          "type": "input.pointer",
          "at": {
            "monoUs": 5110000,
            "wallUs": 1781827200110000
          },
          "input": {
            "pointerId": 1,
