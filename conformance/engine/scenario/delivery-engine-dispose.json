            "pointerId": 1,
            "phase": "up",
            "x": 100.0,
            "y": 300.0,
            "device": "touch"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "capture.request",
              "requestId": "capture_request-2",
              "trigger": "interaction",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 5120000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            }
          ]
        }
      },
