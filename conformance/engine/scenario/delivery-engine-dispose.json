                    "sessionId",
                    "srv-1"
                  ],
                  [
                    "frameNos",
                    "3"
                  ],
                  [
                    "frameMetadata",
                    "[{\"id\":\"frame-3\",\"atMs\":140,\"width\":1080,\"height\":2400,\"contentHash\":\"hash-capture_request-2\",\"masked\":true,\"trigger\":\"interaction\",\"byteLength\":48000,\"captureMicros\":12000,\"captureSessionId\":\"session-1781827200000000\"}]"
                  ]
                ],
                "frames": [
                  {
                    "handle": "h-capture_request-2",
                    "filename": "3.jpg"
