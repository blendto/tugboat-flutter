              "kind": "event",
              "event": {
                "id": "event-4",
                "atMs": 200,
                "type": "external_event",
                "stream": "evidence",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "name": "pending"
                }
              },
              "userId": "user-configured"
            }
          ],
          "effects": []
