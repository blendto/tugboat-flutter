            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "error": {
            "status": "invalid_message",
            "path": "$.type"
          }
        }
      }
