{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "delivery-answer-deadline",
  "description": "Change C15: every http.send arms delivery.answer.<requestId> at timeoutMs + answerGraceMs. Without a transport.result by then the engine treats the request as timed out (retry rules apply) and ignores a late answer, so a host bug cannot stall delivery.",
  "contract": {
    "sessionSchemaVersion": 10,
    "fingerprintSchemaVersion": 6
  },
  "engineOnly": [
    "C15"
  ],
  "input": {
    "configure": {
      "host": {"$preset": "default-host", "configuredUserId": "user-configured"},
      "collector": {
        "enabled": true,
        "answerGraceMs": 1000
      }
    },
    "steps": [
      {
        "note": "session_start's answer is due by 15 s + 1 s",
        "send": {
          "type": "session.start",
          "at": {
            "monoUs": 5000000,
            "wallUs": 1781827200000000
          },
          "input": {
            "viewport": {
              "width": 412.0,
              "height": 915.0
            },
            "platform": "android",
            "sessionEpoch": 0
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "event-0",
                "atMs": 0,
                "type": "session_start",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000"
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 8000000
            },
            {
              "type": "http.send",
              "requestId": "http-0",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827200000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}",
              "sessionId": "session-1781827200000000",
              "deliveryKeys": [
                "session-1781827200000000/l/session_start/2026-06-19T00:00:00.000Z"
              ],
              "isSessionEnd": false
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-0",
              "atMonoUs": 21000000
            },
            {
              "type": "capture.request",
              "requestId": "capture-0",
              "trigger": "initial",
              "force": true,
              "requireFreshPaint": true,
              "dropWhenBusy": false,
              "notBeforeMonoUs": 5000000,
              "context": {
                "routeEpoch": 0,
                "boundaryGeneration": 0
              },
              "scale": 1.0
            },
            {
              "type": "timer.schedule",
              "timerId": "capture.answer.capture-0",
              "atMonoUs": 10000000
            }
          ]
        }
      },
      {
        "note": "a trigger while the request is unanswered marks a follow-up",
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 8000000,
            "wallUs": 1781827203000000
          },
          "input": {
            "timerId": "delivery.flush"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 11000000
            }
          ]
        }
      },
      {
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 11000000,
            "wallUs": 1781827206000000
          },
          "input": {
            "timerId": "delivery.flush"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 14000000
            }
          ]
        }
      },
      {
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 14000000,
            "wallUs": 1781827209000000
          },
          "input": {
            "timerId": "delivery.flush"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 17000000
            }
          ]
        }
      },
      {
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 17000000,
            "wallUs": 1781827212000000
          },
          "input": {
            "timerId": "delivery.flush"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 20000000
            }
          ]
        }
      },
      {
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 20000000,
            "wallUs": 1781827215000000
          },
          "input": {
            "timerId": "delivery.flush"
          }
        },
        "expect": {
          "records": [],
          "effects": [
            {
              "type": "timer.schedule",
              "timerId": "delivery.flush",
              "atMonoUs": 23000000
            }
          ]
        }
      },
      {
        "note": "no answer: a timeout, so session_start stays at the head and the follow-up pass posts it again",
        "send": {
          "type": "timer.fired",
          "at": {
            "monoUs": 21000000,
            "wallUs": 1781827216000000
          },
          "input": {
            "timerId": "delivery.answer.http-0"
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "collector-request-0",
                "atMs": 16000,
                "type": "capture_diagnostic",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "component": "collector_request",
                  "path": "/v1/sessions",
                  "result": "failed",
                  "error": "timeout"
                }
              },
              "userId": "user-configured"
            },
            {
              "kind": "event",
              "event": {
                "id": "collector-flush-1",
                "atMs": 16000,
                "type": "capture_diagnostic",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "component": "collector_flush",
                  "result": "slow",
                  "durationMs": 16000,
                  "step": "sessions",
                  "stepDurationMs": 16000
                }
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "http.send",
              "requestId": "http-1",
              "lane": "lifecycle",
              "path": "/v1/sessions",
              "timeoutMs": 15000,
              "jsonBody": "{\"sessionId\":\"session-1781827200000000\",\"eventType\":\"session_start\",\"atMs\":0,\"triggeredAt\":\"2026-06-19T00:00:00.000Z\",\"userId\":\"user-configured\",\"appInfo\":{\"version\":\"2.4.0\",\"buildNumber\":\"240\",\"appId\":\"com.example.app\",\"packageName\":\"com.example.app\"},\"device\":{\"id\":\"device-0001\",\"platform\":\"android\",\"manufacturer\":\"Google\",\"model\":\"Pixel 8\",\"osVersion\":\"15\",\"networkType\":\"wifi\",\"screenSize\":{\"width\":412.0,\"height\":915.0},\"screenDensity\":2.625,\"screenDpi\":420,\"screenPixelDensity\":2.625},\"ipInfo\":{\"ip\":\"203.0.113.7\"},\"locale\":{\"language\":\"en\",\"country\":\"US\",\"timezone\":\"Europe/Lisbon\"}}",
              "sessionId": "session-1781827200000000",
              "deliveryKeys": [
                "session-1781827200000000/l/session_start/2026-06-19T00:00:00.000Z"
              ],
              "isSessionEnd": false
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-1",
              "atMonoUs": 37000000
            }
          ]
        }
      },
      {
        "note": "the late answer to the abandoned request is ignored",
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 21100000,
            "wallUs": 1781827216100000
          },
          "input": {
            "requestId": "http-0",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-1\"}"
          }
        },
        "expect": {
          "records": [],
          "effects": []
        }
      },
      {
        "note": "the retry is accepted; its deadline timer is cancelled",
        "send": {
          "type": "transport.result",
          "at": {
            "monoUs": 21200000,
            "wallUs": 1781827216200000
          },
          "input": {
            "requestId": "http-1",
            "outcome": "http",
            "status": 202,
            "body": "{\"accepted\":true,\"sessionId\":\"srv-1\"}"
          }
        },
        "expect": {
          "records": [
            {
              "kind": "event",
              "event": {
                "id": "collector-request-2",
                "atMs": 16200,
                "type": "capture_diagnostic",
                "stream": "semantic",
                "captureSessionId": "session-1781827200000000",
                "data": {
                  "component": "collector_request",
                  "path": "/v1/sessions",
                  "result": "recovered"
                }
              },
              "userId": "user-configured"
            }
          ],
          "effects": [
            {
              "type": "timer.cancel",
              "timerId": "delivery.answer.http-1"
            },
            {
              "type": "http.send",
              "requestId": "http-2",
              "lane": "events",
              "path": "/v1/events/batch",
              "timeoutMs": 15000,
              "jsonBody": "{\"events\":[{\"id\":\"collector-request-0\",\"atMs\":16000,\"triggeredAt\":\"2026-06-19T00:00:16.000Z\",\"userId\":\"user-configured\",\"eventType\":\"capture_diagnostic\",\"stream\":\"semantic\",\"enrichmentCandidate\":false,\"payload\":{\"component\":\"collector_request\",\"path\":\"/v1/sessions\",\"result\":\"failed\",\"error\":\"timeout\"},\"build\":{\"appId\":\"com.example.app\",\"platform\":\"android\",\"versionName\":\"2.4.0\",\"buildNumber\":\"240\",\"fingerprintSchemaVersion\":6},\"sessionId\":\"srv-1\"},{\"id\":\"collector-flush-1\",\"atMs\":16000,\"triggeredAt\":\"2026-06-19T00:00:16.000Z\",\"userId\":\"user-configured\",\"eventType\":\"capture_diagnostic\",\"stream\":\"semantic\",\"enrichmentCandidate\":false,\"payload\":{\"component\":\"collector_flush\",\"result\":\"slow\",\"durationMs\":16000,\"step\":\"sessions\",\"stepDurationMs\":16000},\"build\":{\"appId\":\"com.example.app\",\"platform\":\"android\",\"versionName\":\"2.4.0\",\"buildNumber\":\"240\",\"fingerprintSchemaVersion\":6},\"sessionId\":\"srv-1\"},{\"id\":\"collector-request-2\",\"atMs\":16200,\"triggeredAt\":\"2026-06-19T00:00:16.200Z\",\"userId\":\"user-configured\",\"eventType\":\"capture_diagnostic\",\"stream\":\"semantic\",\"enrichmentCandidate\":false,\"payload\":{\"component\":\"collector_request\",\"path\":\"/v1/sessions\",\"result\":\"recovered\"},\"build\":{\"appId\":\"com.example.app\",\"platform\":\"android\",\"versionName\":\"2.4.0\",\"buildNumber\":\"240\",\"fingerprintSchemaVersion\":6},\"sessionId\":\"srv-1\"}]}",
              "sessionId": "srv-1",
              "deliveryKeys": [
                "srv-1/e/97f1ad223f0d30d2"
              ],
              "isSessionEnd": false
            },
            {
              "type": "timer.schedule",
              "timerId": "delivery.answer.http-2",
              "atMonoUs": 37200000
            }
          ]
        }
      }
    ]
  },
