          "appId": "com.example.app"
        },
        "device": {
          "id": "device-0001",
          "platform": "android",
          "manufacturer": "Google",
          "model": "Pixel 8",
          "osVersion": "15",
          "networkType": "wifi",
          "screenSize": {
            "width": 412.0,
            "height": 915.0
          },
          "screenDensity": 2.625,
          "screenDpi": 420,
          "screenPixelDensity": 2.625
        },
        "ip": {
          "ip": "203.0.113.7"
        },
        "locale": {
          "language": "en",
          "country": "US",
          "timezone": "Europe/Lisbon"
        },
        "configuredUserId": null
      }
    },
