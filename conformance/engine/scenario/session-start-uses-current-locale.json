{
  "fixtureFormat": 1,
  "kind": "engine.scenario",
  "name": "session-start-uses-current-locale",
  "description": "locale.set before the first session emits nothing but becomes the current locale; a session.start without a locale stamps it on the session and on session_start. Without explorationRunId or activationRequestId the session and events omit them.",
